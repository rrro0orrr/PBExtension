{
  "name": "pbextension",
  "description": "rrro0orrr's Paperback extensions (fork of karrot0/KakarotExtension)",
  "author": "rrro0orrr",
  "contributors": [
    {
      "name": "Karrot (karrot0)",
      "url": "https://github.com/karrot0"
    }
  ],
  "keywords": [
    "Paperback",
    "extensions"
  ],
  "version": "0.9.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rrro0orrr/PBExtension.git"
  },
  "bugs": {
    "url": "https://github.com/rrro0orrr/PBExtension/issues"
  },
  "homepage": "https://github.com/rrro0orrr/PBExtension#readme",
  "repositoryName": "PBExtension",
  "repositoryDescription": "rrro0orrr's Paperback extensions, forked from KakarotExtension by Karrot",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --fix",
    "lint:check": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "tsc": "tsc",
    "bundle": "paperback-cli bundle",
    "test": "node scripts/test.mjs --noConsole --output ./bundles/tests.json",
    "serve": "paperback-cli serve",
    "logcat": "paperback-cli logcat --ip 192.168.1.65",
    "dev": "paperback-cli serve --watch --port 3000",
    "prepare": "husky"
  },
  "devDependencies": {
    "@paperback/toolchain": "1.0.0-alpha.92",
    "@paperback/types": "1.0.0-alpha.92",
    "@types/chai": "^5.2.3",
    "chai": "^6.3.0",
    "cheerio": "^1.2.0",
    "dom-serializer": "^2.0.0",
    "domhandler": "^5.0.3",
    "htmlparser2": "^10.1.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^6.0.3"
  }
}
